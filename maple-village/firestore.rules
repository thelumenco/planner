rules_version = '2';
// Honeybrook: each player's save slots live under players/{their uid}. Only that signed-in player can read or
// write them; nothing else in the database is readable or writable by anyone.
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
